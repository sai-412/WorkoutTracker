@page "/"
@rendermode InteractiveServer
@using WorkoutTracker.Components.Shared
@namespace WorkoutTracker.Components.Shared
<PageTitle>Home</PageTitle>

<h1>Dashboard</h1>


<div>
    <h2>Exercises</h2>
    <NewButton ButtonName="+ New Exercice" OnClickCallback="HandleAddExercise"></NewButton>
    <ExerciseTable @ref="exerciseTable"></ExerciseTable>
</div>

@code 
{
    private ExerciseTable exerciseTable;

    private void HandleAddExercise()
    {
        exerciseTable.AddExercise();
    }
}
    